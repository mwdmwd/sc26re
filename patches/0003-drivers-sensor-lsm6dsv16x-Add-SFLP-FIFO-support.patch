+	}
+
 	switch (chan) {
 	case SENSOR_CHAN_ACCEL_X:
 	case SENSOR_CHAN_ACCEL_Y:
@@ -756,6 +1037,52 @@ static const struct sensor_driver_api lsm6dsv16x_driver_api = {
 	.channel_get = lsm6dsv16x_channel_get,
 };
 
+static int lsm6dsv16x_init_fifo_sflp(const struct device *dev)
+{
+	const struct lsm6dsv16x_config *cfg = dev->config;
+	stmdev_ctx_t *ctx = (stmdev_ctx_t *)&cfg->ctx;
+	lsm6dsv16x_fifo_sflp_raw_t sflp_batch = {
+		.game_rotation = 1,
+		.gravity = 0,
+		.gbias = 1,
+	};
+
+	if (lsm6dsv16x_fifo_watermark_set(ctx, 3) < 0) {
+		LOG_DBG("failed to set FIFO watermark");
+		return -EIO;
+	}
+	if (lsm6dsv16x_sflp_game_rotation_set(ctx, 1) < 0) {
+		LOG_DBG("failed to enable SFLP game rotation");
+		return -EIO;
+	}
+	if (lsm6dsv16x_sflp_data_rate_set(ctx, LSM6DSV16X_SFLP_240Hz) < 0) {
+		LOG_DBG("failed to set SFLP data rate");
+		return -EIO;
+	}
+	if (lsm6dsv16x_fifo_sflp_batch_set(ctx, sflp_batch) < 0) {
+		LOG_DBG("failed to enable SFLP FIFO batching");
+		return -EIO;
+	}
+	if (lsm6dsv16x_block_data_update_set(ctx, 1) < 0) {
+		LOG_DBG("failed to set BDU mode");
+		return -EIO;
+	}
+	if (lsm6dsv16x_fifo_timestamp_batch_set(ctx, LSM6DSV16X_TMSTMP_DEC_1) < 0) {
+		LOG_DBG("failed to enable FIFO timestamp batching");
+		return -EIO;
+	}
+	if (lsm6dsv16x_timestamp_set(ctx, 1) < 0) {
+		LOG_DBG("failed to enable timestamp counter");
+		return -EIO;
+	}
+	if (lsm6dsv16x_fifo_mode_set(ctx, LSM6DSV16X_STREAM_MODE) < 0) {
+		LOG_DBG("failed to set FIFO stream mode");
+		return -EIO;
+	}
+
+	return 0;
+}
+
 static int lsm6dsv16x_init_chip(const struct device *dev)
 {
 	const struct lsm6dsv16x_config *cfg = dev->config;
@@ -825,8 +1152,8 @@ static int lsm6dsv16x_init_chip(const struct device *dev)
 		return -EIO;
 	}
 
-	if (lsm6dsv16x_block_data_update_set(ctx, 1) < 0) {
-		LOG_DBG("failed to set BDU mode");
+	if (lsm6dsv16x_init_fifo_sflp(dev) < 0) {
+		LOG_ERR("failed to initialize SFLP FIFO");
 		return -EIO;
 	}
 
