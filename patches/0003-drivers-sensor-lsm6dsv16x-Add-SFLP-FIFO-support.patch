+/**
+ * lsm6dsv16x_enable_fifo_int - enable selected int pin to generate FIFO watermark interrupt
+ */
+static int lsm6dsv16x_enable_fifo_int(const struct device *dev, int enable)
+{
+	const struct lsm6dsv16x_config *cfg = dev->config;
+	stmdev_ctx_t *ctx = (stmdev_ctx_t *)&cfg->ctx;
+	lsm6dsv16x_pin_int_route_t val;
+	int ret;
+
+	if (cfg->drdy_pin == 1) {
+		ret = lsm6dsv16x_pin_int1_route_get(ctx, &val);
+		if (ret < 0) {
+			LOG_ERR("pin_int1_route_get error");
