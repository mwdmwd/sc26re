 	case SENSOR_ATTR_CONFIGURATION:
 		switch (val->val1) {
 		case 0: /* High Performance */
@@ -395,6 +500,80 @@ static int lsm6dsv16x_sample_fetch_gyro(const struct device *dev)
 	return 0;
 }
 
+static int lsm6dsv16x_sample_fetch_fifo(const struct device *dev, bool *accel_updated,
+					bool *gyro_updated)
+{
+	const struct lsm6dsv16x_config *cfg = dev->config;
+	stmdev_ctx_t *ctx = (stmdev_ctx_t *)&cfg->ctx;
+	struct lsm6dsv16x_data *data = dev->data;
+	lsm6dsv16x_fifo_status_t status;
+	uint16_t level;
+
+	if (accel_updated != NULL) {
+		*accel_updated = false;
+	}
+	if (gyro_updated != NULL) {
+		*gyro_updated = false;
+	}
+
+	if (lsm6dsv16x_fifo_status_get(ctx, &status) < 0) {
+		LOG_DBG("Failed to read FIFO status");
+		return -EIO;
+	}
+
+	level = status.fifo_level;
+	for (uint16_t i = 0; i < level; i++) {
+		lsm6dsv16x_fifo_out_raw_t sample;
+
+		if (lsm6dsv16x_fifo_out_raw_get(ctx, &sample) < 0) {
+			LOG_DBG("Failed to read FIFO sample");
+			return -EIO;
+		}
+
+		switch (sample.tag) {
+		case LSM6DSV16X_FIFO_EMPTY:
+			return 0;
+		case LSM6DSV16X_GY_NC_TAG:
+		case LSM6DSV16X_GY_NC_T_2_TAG:
+		case LSM6DSV16X_GY_NC_T_1_TAG:
+		case LSM6DSV16X_GY_2XC_TAG:
+		case LSM6DSV16X_GY_3XC_TAG:
+			lsm6dsv16x_fifo_copy_axes(data->gyro, sample.data);
+			if (gyro_updated != NULL) {
+				*gyro_updated = true;
+			}
+			break;
+		case LSM6DSV16X_XL_NC_TAG:
+		case LSM6DSV16X_XL_NC_T_2_TAG:
+		case LSM6DSV16X_XL_NC_T_1_TAG:
+		case LSM6DSV16X_XL_2XC_TAG:
+		case LSM6DSV16X_XL_3XC_TAG:
+			lsm6dsv16x_fifo_copy_axes(data->acc, sample.data);
+			if (accel_updated != NULL) {
+				*accel_updated = true;
+			}
+			break;
+		case LSM6DSV16X_TIMESTAMP_TAG:
+			data->timestamp = sys_get_le32(sample.data);
+			data->timestamp_valid = true;
+			break;
+		case LSM6DSV16X_SFLP_GAME_ROTATION_VECTOR_TAG:
+			lsm6dsv16x_fifo_copy_axes(data->sflp_game_rotation, sample.data);
+			data->sflp_game_rotation_valid = true;
+			break;
+		case LSM6DSV16X_SFLP_GYROSCOPE_BIAS_TAG:
+			lsm6dsv16x_fifo_copy_axes(data->sflp_gyro_bias, sample.data);
+			data->sflp_gyro_bias_valid = true;
+			break;
+		default:
+			LOG_DBG("discarding unsupported FIFO tag 0x%x", sample.tag);
+			break;
+		}
+	}
+
+	return 0;
+}
+
