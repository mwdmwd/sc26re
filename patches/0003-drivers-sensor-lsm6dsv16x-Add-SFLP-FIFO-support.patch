 {
@@ -682,6 +953,16 @@ static int lsm6dsv16x_channel_get(const struct device *dev, enum sensor_channel
 {
 	struct lsm6dsv16x_data *data = dev->data;
 
+	if (chan == (enum sensor_channel)LSM6DSV16X_SENSOR_CHAN_SFLP_GAME_ROTATION_VECTOR) {
