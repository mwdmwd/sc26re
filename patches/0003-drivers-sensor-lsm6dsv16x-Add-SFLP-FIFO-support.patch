+	if (chan == (enum sensor_channel)LSM6DSV16X_SENSOR_CHAN_FIFO) {
+		return lsm6dsv16x_sample_fetch_fifo(dev, NULL, NULL);
+	}
+
 	switch (chan) {
 	case SENSOR_CHAN_ACCEL_XYZ:
-		lsm6dsv16x_sample_fetch_accel(dev);
+		err = lsm6dsv16x_sample_fetch_accel(dev);
+		if (err) {
+			return err;
+		}
 		break;
 	case SENSOR_CHAN_GYRO_XYZ:
-		lsm6dsv16x_sample_fetch_gyro(dev);
+		err = lsm6dsv16x_sample_fetch_gyro(dev);
+		if (err) {
+			return err;
+		}
 		break;
 #if defined(CONFIG_LSM6DSV16X_ENABLE_TEMP)
 	case SENSOR_CHAN_DIE_TEMP:
-		lsm6dsv16x_sample_fetch_temp(dev);
+		err = lsm6dsv16x_sample_fetch_temp(dev);
+		if (err) {
+			return err;
+		}
 		break;
 #endif
 	case SENSOR_CHAN_ALL:
-		lsm6dsv16x_sample_fetch_accel(dev);
-		lsm6dsv16x_sample_fetch_gyro(dev);
+		err = lsm6dsv16x_sample_fetch_accel(dev);
+		if (err) {
+			return err;
+		}
+
+		err = lsm6dsv16x_sample_fetch_gyro(dev);
+		if (err) {
+			return err;
+		}
 #if defined(CONFIG_LSM6DSV16X_ENABLE_TEMP)
-		lsm6dsv16x_sample_fetch_temp(dev);
+		err = lsm6dsv16x_sample_fetch_temp(dev);
+		if (err) {
+			return err;
+		}
 #endif
 #if defined(CONFIG_LSM6DSV16X_SENSORHUB)
 		if (data->shub_inited) {
-			lsm6dsv16x_sample_fetch_shub(dev);
+			err = lsm6dsv16x_sample_fetch_shub(dev);
+			if (err) {
+				return err;
+			}
 		}
 #endif
 		break;
@@ -548,6 +754,71 @@ static int lsm6dsv16x_gyro_channel_get(enum sensor_channel chan, struct sensor_v
 	return lsm6dsv16x_gyro_get_channel(chan, val, data, data->gyro_gain);
 }
 
+static int lsm6dsv16x_sflp_game_rotation_channel_get(struct sensor_value *val,
+						     struct lsm6dsv16x_data *data)
+{
+	float x = 0.0f;
+	float y = 0.0f;
+	float z = 0.0f;
+	float w = 1.0f;
+
+	if (data->sflp_game_rotation_valid) {
+		x = lsm6dsv16x_sflp_half_to_float((uint16_t)data->sflp_game_rotation[0]);
+		y = lsm6dsv16x_sflp_half_to_float((uint16_t)data->sflp_game_rotation[1]);
+		z = lsm6dsv16x_sflp_half_to_float((uint16_t)data->sflp_game_rotation[2]);
+
+		float sumsq = x * x + y * y + z * z;
+
+		if (sumsq > 1.0f) {
+			float norm = sqrtf(sumsq);
+
+			x /= norm;
+			y /= norm;
+			z /= norm;
+			sumsq = 1.0f;
+		}
+
+		w = sqrtf(1.0f - sumsq);
+	}
+
+	sensor_value_from_float(&val[0], x);
+	sensor_value_from_float(&val[1], y);
+	sensor_value_from_float(&val[2], z);
+	sensor_value_from_float(&val[3], w);
+
+	return 0;
+}
+
+static int lsm6dsv16x_sflp_gyro_bias_channel_get(struct sensor_value *val,
+						 struct lsm6dsv16x_data *data)
+{
+	if (!data->sflp_gyro_bias_valid) {
+		return -ENODATA;
+	}
+
+	for (uint8_t i = 0; i < 3; i++) {
+		lsm6dsv16x_gyro_convert(val++, data->sflp_gyro_bias[i], GAIN_UNIT_G);
+	}
+
+	return 0;
+}
+
+static int lsm6dsv16x_timestamp_channel_get(struct sensor_value *val, struct lsm6dsv16x_data *data)
+{
+	if (!data->timestamp_valid) {
+		return -ENODATA;
+	}
+
+	/*
+	 * Private driver channel: raw SFLP timestamp in microseconds modulo
+	 * 2^32 before being viewed through signed val1.
+	 */
+	val->val1 = (int32_t)(data->timestamp * LSM6DSV16X_TIMESTAMP_US_PER_TICK);
+	val->val2 = 0;
+
+	return 0;
+}
