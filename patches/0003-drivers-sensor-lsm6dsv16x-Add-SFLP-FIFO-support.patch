+#define LSM6DSV16X_DEGREES_PER_RADIAN    57.29577951308232
+#define LSM6DSV16X_TIMESTAMP_US_PER_TICK 21U
+#define LSM6DSV16X_ODR_RATE_MASK         0x0f
+#define LSM6DSV16X_ODR_MODE_MASK         0xf0
+#define LSM6DSV16X_ODR_MODE_HP           0x00
+#define LSM6DSV16X_ODR_MODE_HA01         0x10
+#define LSM6DSV16X_ODR_MODE_HA02         0x20
+
 /*
  * values taken from lsm6dsv16x_data_rate_t in hal/st module. The mode/accuracy
  * should be selected through accel-odr property in DT
@@ -101,6 +111,61 @@ static int lsm6dsv16x_gyro_range_to_fs_val(int32_t range)
 	return -EINVAL;
 }
 
+static int16_t lsm6dsv16x_fifo_raw_axis(const uint8_t raw[6], uint8_t axis)
+{
+	return (int16_t)sys_get_le16(&raw[axis * 2]);
+}
+
+static void lsm6dsv16x_fifo_copy_axes(int16_t dst[3], const uint8_t raw[6])
+{
+	for (uint8_t i = 0; i < 3; i++) {
+		dst[i] = lsm6dsv16x_fifo_raw_axis(raw, i);
+	}
+}
+
+static float lsm6dsv16x_sflp_half_to_float(uint16_t raw)
+{
+	uint16_t sign = raw & BIT(15);
+	uint16_t exp = (raw >> 10) & 0x1f;
+	uint16_t mant = raw & 0x03ff;
+	float value;
+
+	if (exp == 0) {
+		value = ldexpf((float)mant, -24);
+	} else if (exp == 0x1f) {
+		value = 1.0f;
+	} else {
+		value = ldexpf(1.0f + (float)mant / 1024.0f, (int)exp - 15);
+	}
+
+	return sign ? -value : value;
+}
+
+static int lsm6dsv16x_odr_to_fifo_batch(uint8_t odr)
+{
+	uint8_t batch = odr & LSM6DSV16X_ODR_RATE_MASK;
+
+	if (batch > LSM6DSV16X_XL_BATCHED_AT_7680Hz) {
+		return -EINVAL;
+	}
+
+	switch (odr & LSM6DSV16X_ODR_MODE_MASK) {
+	case LSM6DSV16X_ODR_MODE_HP:
+		break;
+	case LSM6DSV16X_ODR_MODE_HA01:
+	case LSM6DSV16X_ODR_MODE_HA02:
+		if (batch < LSM6DSV16X_XL_BATCHED_AT_15Hz) {
+			return -EINVAL;
+		}
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* FIFO batching encodes the rate field without the ODR accuracy mode. */
+	return batch;
+}
+
