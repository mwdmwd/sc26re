+static int lsm6dsv16x_gyro_offset_set(const struct device *dev, const struct sensor_value *val)
+{
+	const struct lsm6dsv16x_config *cfg = dev->config;
+	stmdev_ctx_t *ctx = (stmdev_ctx_t *)&cfg->ctx;
+	lsm6dsv16x_sflp_gbias_t gbias = {
+		.gbias_x = sensor_value_to_double(&val[0]) * LSM6DSV16X_DEGREES_PER_RADIAN,
+		.gbias_y = sensor_value_to_double(&val[1]) * LSM6DSV16X_DEGREES_PER_RADIAN,
+		.gbias_z = sensor_value_to_double(&val[2]) * LSM6DSV16X_DEGREES_PER_RADIAN,
+	};
+
+	if (lsm6dsv16x_sflp_game_gbias_set(ctx, &gbias) < 0) {
+		LOG_DBG("failed to set SFLP gyro bias");
+		return -EIO;
+	}
+
+	return 0;
+}
+
