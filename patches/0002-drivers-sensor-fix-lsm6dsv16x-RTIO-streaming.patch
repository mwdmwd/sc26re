 LOG_MODULE_DECLARE(LSM6DSV16X_RTIO);
 
+static void lsm6dsv16x_complete_streaming_sqe(struct lsm6dsv16x_data *data, int result)
+{
+	struct rtio_iodev_sqe *wip = data->streaming_sqe;
+
+	__ASSERT_NO_MSG(wip != NULL);
+	data->streaming_sqe = NULL;
+	if (result < 0 || (wip->sqe.flags & RTIO_SQE_CANCELED) != 0U) {
+		/* Force a clean FIFO setup when the application restarts the stream. */
+		data->trig_cfg = (struct trigger_config){ 0 };
+	}
+	if (result < 0) {
+		rtio_iodev_sqe_err(wip, result);
+	} else {
+		rtio_iodev_sqe_ok(wip, result);
+	}
+}
+
+static int lsm6dsv16x_transaction_result(struct rtio *r, int result)
+{
+	int queued_result = rtio_flush_completion_queue(r);
+
+	return result < 0 ? result : queued_result;
+}
+
+static int lsm6dsv16x_prepare_empty_fifo_data(struct lsm6dsv16x_data *data)
+{
+	uint8_t *buf;
+	uint32_t buf_len;
+
+	if (rtio_sqe_rx_buf(data->streaming_sqe, sizeof(struct lsm6dsv16x_fifo_data),
+			    sizeof(struct lsm6dsv16x_fifo_data), &buf, &buf_len) != 0) {
+		return -ENOMEM;
+	}
+
+	struct lsm6dsv16x_fifo_data *rx_data = (struct lsm6dsv16x_fifo_data *)buf;
+
+	memset(buf, 0, buf_len);
+	rx_data->header.is_fifo = 1;
+	rx_data->header.timestamp = data->timestamp;
+	rx_data->int_status = data->fifo_status[1];
+	rx_data->fifo_count = 0;
+
+	return 0;
+}
