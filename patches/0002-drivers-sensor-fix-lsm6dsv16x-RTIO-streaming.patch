+static int lsm6dsv16x_read_reg_async(const struct device *dev, uint8_t reg_addr, uint8_t *buf,
+				     uint32_t len, rtio_callback_t callback)
+{
+	struct lsm6dsv16x_data *data = dev->data;
+	struct rtio_sqe *sqes[3];
+	int err;
+
+	err = rtio_sqe_acquire_array(data->rtio_ctx, ARRAY_SIZE(sqes), sqes);
+	if (err != 0) {
+		return err;
+	}
+
+	rtio_sqe_prep_tiny_write(sqes[0], data->iodev, RTIO_PRIO_NORM, &reg_addr, 1, NULL);
+	sqes[0]->flags = RTIO_SQE_TRANSACTION;
+	rtio_sqe_prep_read(sqes[1], data->iodev, RTIO_PRIO_NORM, buf, len, NULL);
+	sqes[1]->flags = RTIO_SQE_CHAINED;
+	if (data->bus_type == RTIO_BUS_I2C) {
+		sqes[1]->iodev_flags |= RTIO_IODEV_I2C_STOP | RTIO_IODEV_I2C_RESTART;
+	} else if (data->bus_type == RTIO_BUS_I3C) {
+		sqes[1]->iodev_flags |= RTIO_IODEV_I3C_STOP | RTIO_IODEV_I3C_RESTART;
+	}
+	rtio_sqe_prep_callback_no_cqe(sqes[2], callback, (void *)dev, data->streaming_sqe);
+
+	return rtio_submit(data->rtio_ctx, 0);
+}
