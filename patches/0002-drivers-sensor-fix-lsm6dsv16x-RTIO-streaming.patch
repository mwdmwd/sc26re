+		/*
+		 * FIFO setup can assert the interrupt while it is disabled. Arm it as a
+		 * level interrupt so an already-active threshold is not missed. The GPIO
+		 * callback disables it before scheduling the asynchronous read.
+		 */
+		gpio_pin_interrupt_configure_dt(lsm6dsv16x->drdy_gpio, GPIO_INT_LEVEL_ACTIVE);
 	}
