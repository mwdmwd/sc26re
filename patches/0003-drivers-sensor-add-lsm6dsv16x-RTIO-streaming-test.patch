diff --git a/tests/drivers/sensor/lsm6dsv16x_stream/src/lsm6dsv16x_emul.c b/tests/drivers/sensor/lsm6dsv16x_stream/src/lsm6dsv16x_emul.c
new file mode 100644
index 00000000000..e88439952bc
--- /dev/null
+++ b/tests/drivers/sensor/lsm6dsv16x_stream/src/lsm6dsv16x_emul.c
@@ -0,0 +1,169 @@
+#include "lsm6dsv16x_emul.h"
+
+#include <errno.h>
+#include <string.h>
+
+#include <zephyr/device.h>
+#include <zephyr/drivers/emul.h>
+#include <zephyr/drivers/i2c.h>
+#include <zephyr/drivers/i2c_emul.h>
+#include <zephyr/sys/util.h>
+
+#define SENSOR_NODE DT_NODELABEL(lsm6dsv16x)
+
+#define REG_FUNC_CFG_ACCESS      0x01
+#define REG_EMB_FUNC_EXEC_STATUS 0x07
+#define REG_WHO_AM_I             0x0f
+#define REG_FIFO_STATUS1         0x1b
+#define REG_STATUS               0x1e
+#define REG_FIFO_DATA_OUT_TAG    0x78
+
+#define WHO_AM_I_VALUE         0x70
+#define FUNC_CFG_SHUB_ACCESS   BIT(6)
+#define FUNC_CFG_EMB_ACCESS    BIT(7)
+#define FIFO_STATUS2_WATERMARK BIT(7)
+
+enum register_bank {
+	BANK_MAIN,
+	BANK_SENSOR_HUB,
+	BANK_EMBEDDED,
+	BANK_COUNT,
+};
+
+struct lsm6dsv16x_emul_data {
+	uint8_t registers[BANK_COUNT][UINT8_MAX + 1];
+	uint32_t read_count[UINT8_MAX + 1];
+	uint8_t func_cfg_access;
+	uint8_t address;
+	enum register_bank bank;
+	uint8_t fail_reg;
+	uint8_t fail_fill;
+	int fail_error;
+	bool fail_armed;
+};
+
+static struct lsm6dsv16x_emul_data emul_data;
+
+static uint8_t emul_read_byte(struct lsm6dsv16x_emul_data *data, uint8_t reg)
+{
+	if (reg == REG_FUNC_CFG_ACCESS) {
+		return data->func_cfg_access;
+	}
+
+	if (data->bank == BANK_MAIN && reg == REG_WHO_AM_I) {
+		return WHO_AM_I_VALUE;
+	}
+
+	/* SFLP GBIAS setup polls these two bits without a timeout. */
+	if (data->bank == BANK_MAIN && reg == REG_STATUS) {
+		return data->registers[BANK_MAIN][reg] | BIT(0);
+	}
+
+	if (data->bank == BANK_EMBEDDED && reg == REG_EMB_FUNC_EXEC_STATUS) {
+		return data->registers[BANK_EMBEDDED][reg] | BIT(0);
+	}
+
+	return data->registers[data->bank][reg];
+}
+
+static void emul_write_byte(struct lsm6dsv16x_emul_data *data, uint8_t reg, uint8_t value)
+{
+	if (reg == REG_FUNC_CFG_ACCESS) {
+		data->func_cfg_access = value;
+		if ((value & FUNC_CFG_EMB_ACCESS) != 0U) {
+			data->bank = BANK_EMBEDDED;
+		} else if ((value & FUNC_CFG_SHUB_ACCESS) != 0U) {
+			data->bank = BANK_SENSOR_HUB;
+		} else {
+			data->bank = BANK_MAIN;
+		}
+		return;
+	}
+
+	data->registers[data->bank][reg] = value;
+}
+
+static int lsm6dsv16x_emul_transfer(const struct emul *target, struct i2c_msg *msgs, int num_msgs,
+				    int addr)
+{
+	struct lsm6dsv16x_emul_data *data = target->data;
+
+	ARG_UNUSED(addr);
+
+	for (int i = 0; i < num_msgs; i++) {
+		struct i2c_msg *msg = &msgs[i];
+
+		if ((msg->flags & I2C_MSG_READ) == 0U) {
+			if (msg->len == 0U) {
+				continue;
+			}
+
+			data->address = msg->buf[0];
+			for (uint32_t j = 1; j < msg->len; j++) {
+				emul_write_byte(data, data->address++, msg->buf[j]);
+			}
+			continue;
+		}
+
+		const uint8_t start_reg = data->address;
+
+		data->read_count[start_reg]++;
+		if (data->fail_armed && data->fail_reg == start_reg) {
+			memset(msg->buf, data->fail_fill, msg->len);
+			data->fail_armed = false;
+			return data->fail_error;
+		}
+
+		for (uint32_t j = 0; j < msg->len; j++) {
+			msg->buf[j] = emul_read_byte(data, data->address++);
+		}
+	}
+
+	return 0;
+}
+
+static int lsm6dsv16x_emul_init(const struct emul *target, const struct device *parent)
+{
+	struct lsm6dsv16x_emul_data *data = target->data;
+
+	ARG_UNUSED(parent);
+	memset(data, 0, sizeof(*data));
+	return 0;
+}
+
+static const struct i2c_emul_api lsm6dsv16x_emul_api = {
+	.transfer = lsm6dsv16x_emul_transfer,
+};
+
+EMUL_DT_DEFINE(SENSOR_NODE, lsm6dsv16x_emul_init, &emul_data, NULL, &lsm6dsv16x_emul_api, NULL);
+
+void lsm6dsv16x_emul_set_fifo(const uint8_t payload[7])
+{
+	emul_data.registers[BANK_MAIN][REG_FIFO_STATUS1] = 1;
+	emul_data.registers[BANK_MAIN][REG_FIFO_STATUS1 + 1] = FIFO_STATUS2_WATERMARK;
+	memcpy(&emul_data.registers[BANK_MAIN][REG_FIFO_DATA_OUT_TAG], payload, 7);
+}
+
+void lsm6dsv16x_emul_set_fifo_empty(void)
+{
+	emul_data.registers[BANK_MAIN][REG_FIFO_STATUS1] = 0;
+	emul_data.registers[BANK_MAIN][REG_FIFO_STATUS1 + 1] = 0;
+}
+
+void lsm6dsv16x_emul_fail_next_read(uint8_t reg, int error, uint8_t fill)
+{
+	emul_data.fail_reg = reg;
+	emul_data.fail_error = error;
+	emul_data.fail_fill = fill;
+	emul_data.fail_armed = true;
+}
+
+void lsm6dsv16x_emul_clear_read_counts(void)
+{
+	memset(emul_data.read_count, 0, sizeof(emul_data.read_count));
+}
+
+uint32_t lsm6dsv16x_emul_read_count(uint8_t reg)
+{
+	return emul_data.read_count[reg];
+}
diff --git a/tests/drivers/sensor/lsm6dsv16x_stream/src/lsm6dsv16x_emul.h b/tests/drivers/sensor/lsm6dsv16x_stream/src/lsm6dsv16x_emul.h
new file mode 100644
index 00000000000..db8b855bc9f
--- /dev/null
+++ b/tests/drivers/sensor/lsm6dsv16x_stream/src/lsm6dsv16x_emul.h
@@ -0,0 +1,13 @@
+#ifndef ZEPHYR_TESTS_DRIVERS_SENSOR_LSM6DSV16X_STREAM_EMUL_H_
+#define ZEPHYR_TESTS_DRIVERS_SENSOR_LSM6DSV16X_STREAM_EMUL_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+void lsm6dsv16x_emul_set_fifo(const uint8_t payload[7]);
+void lsm6dsv16x_emul_set_fifo_empty(void);
+void lsm6dsv16x_emul_fail_next_read(uint8_t reg, int error, uint8_t fill);
+void lsm6dsv16x_emul_clear_read_counts(void);
+uint32_t lsm6dsv16x_emul_read_count(uint8_t reg);
+
+#endif /* ZEPHYR_TESTS_DRIVERS_SENSOR_LSM6DSV16X_STREAM_EMUL_H_ */
diff --git a/tests/drivers/sensor/lsm6dsv16x_stream/src/main.c b/tests/drivers/sensor/lsm6dsv16x_stream/src/main.c
new file mode 100644
index 00000000000..20d42eb8984
--- /dev/null
+++ b/tests/drivers/sensor/lsm6dsv16x_stream/src/main.c
@@ -0,0 +1,235 @@
+#include "lsm6dsv16x_emul.h"
+
+#include <errno.h>
+#include <string.h>
+
+#include <zephyr/device.h>
+#include <zephyr/drivers/gpio.h>
+#include <zephyr/drivers/gpio/gpio_emul.h>
+#include <zephyr/drivers/sensor.h>
+#include <zephyr/kernel.h>
+#include <zephyr/rtio/rtio.h>
+#include <zephyr/ztest.h>
+
+#include "lsm6dsv16x_decoder.h"
+
+#define SENSOR_NODE           DT_NODELABEL(lsm6dsv16x)
+#define REG_FIFO_STATUS1      0x1b
+#define REG_FIFO_DATA_OUT_TAG 0x78
+
+static const struct device *const sensor = DEVICE_DT_GET(SENSOR_NODE);
+static const struct gpio_dt_spec interrupt = GPIO_DT_SPEC_GET(SENSOR_NODE, int1_gpios);
+
+static const uint8_t fifo_payload[7] = {
+	0x08, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66,
+};
+
+SENSOR_DT_STREAM_IODEV(stream_iodev, SENSOR_NODE,
+		       {SENSOR_TRIG_FIFO_WATERMARK, SENSOR_STREAM_DATA_INCLUDE});
+SENSOR_DT_STREAM_IODEV(mixed_stream_iodev, SENSOR_NODE,
+		       {SENSOR_TRIG_FIFO_WATERMARK, SENSOR_STREAM_DATA_INCLUDE},
+		       {SENSOR_TRIG_DATA_READY, SENSOR_STREAM_DATA_INCLUDE});
+
+/* One block lets the pool-exhaustion test retain one completed batch. */
+RTIO_DEFINE_WITH_MEMPOOL(stream_ctx, 1, 8, 1, 64, 4);
+
+static void pulse_interrupt(void)
+{
+	zassert_ok(gpio_emul_input_set_dt(&interrupt, 0));
+	zassert_ok(gpio_emul_input_set_dt(&interrupt, 1));
+	zassert_ok(gpio_emul_input_set_dt(&interrupt, 0));
+}
+
+static struct rtio_sqe *start_stream_iodev(struct rtio_iodev *iodev)
+{
+	struct rtio_sqe *handle = NULL;
+
+	zassert_ok(sensor_stream(iodev, &stream_ctx, NULL, &handle));
+	zassert_not_null(handle);
+	/* Sensor submission is deferred to the RTIO work queue. */
+	k_msleep(20);
+	return handle;
+}
+
+static struct rtio_sqe *start_stream(void)
+{
+	return start_stream_iodev(&stream_iodev);
+}
+
+static bool wait_for_completion(struct rtio_cqe *cqe, k_timeout_t timeout)
+{
+	k_timepoint_t deadline = sys_timepoint_calc(timeout);
+
+	do {
+		if (rtio_cqe_copy_out(&stream_ctx, cqe, 1, K_NO_WAIT) == 1) {
+			return true;
+		}
+		/* Let the RTIO work queue run; copy_out's timed path busy-waits. */
+		k_msleep(1);
+	} while (!sys_timepoint_expired(deadline));
+
+	return rtio_cqe_copy_out(&stream_ctx, cqe, 1, K_NO_WAIT) == 1;
+}
+
+static struct rtio_cqe get_completion(void)
+{
+	struct rtio_cqe cqe;
+
+	zassert_true(wait_for_completion(&cqe, K_SECONDS(2)), "stream did not complete");
+	return cqe;
+}
+
+static void expect_no_completion(void)
+{
+	struct rtio_cqe cqe;
+
+	zassert_false(wait_for_completion(&cqe, K_MSEC(20)), "unexpected extra stream completion");
+}
+
+static void expect_error(int error)
+{
+	struct rtio_cqe cqe = get_completion();
+	uint8_t *buf;
+	uint32_t buf_len;
+
+	zassert_equal(error, cqe.result, "expected %d, got %d", error, cqe.result);
+	zassert_equal(-EINVAL, rtio_cqe_get_mempool_buffer(&stream_ctx, &cqe, &buf, &buf_len));
+	expect_no_completion();
+}
+
+static uint8_t *expect_success(uint32_t *buf_len)
+{
+	struct rtio_cqe cqe = get_completion();
+	uint8_t *buf = NULL;
+
+	zassert_ok(cqe.result, "stream failed: %d", cqe.result);
+	zassert_ok(rtio_cqe_get_mempool_buffer(&stream_ctx, &cqe, &buf, buf_len));
+	zassert_not_null(buf);
+	zassert_true(*buf_len >= sizeof(struct lsm6dsv16x_fifo_data) + sizeof(fifo_payload));
+
+	const struct lsm6dsv16x_fifo_data *fifo = (const void *)buf;
+
+	zassert_true(fifo->header.is_fifo);
+	zassert_equal(1, fifo->fifo_count);
+	zassert_mem_equal(buf + sizeof(*fifo), fifo_payload, sizeof(fifo_payload));
+	return buf;
+}
+
+static void stop_stream(struct rtio_sqe *handle)
+{
+	/* Complete the canceled shot without allocating another receive buffer. */
+	lsm6dsv16x_emul_set_fifo_empty();
+	zassert_ok(rtio_sqe_cancel(handle));
+	pulse_interrupt();
+	expect_error(-ECANCELED);
+}
+
+static void prepare_attempt(void)
+{
+	lsm6dsv16x_emul_set_fifo(fifo_payload);
+	lsm6dsv16x_emul_clear_read_counts();
+}
+
+ZTEST(lsm6dsv16x_stream, test_fifo_status_read_failure_recovers)
+{
+	start_stream();
+	prepare_attempt();
+	lsm6dsv16x_emul_fail_next_read(REG_FIFO_STATUS1, -EIO, 0xff);
+	pulse_interrupt();
+	expect_error(-EIO);
+	zassert_equal(1, lsm6dsv16x_emul_read_count(REG_FIFO_STATUS1));
+	zassert_equal(0, lsm6dsv16x_emul_read_count(REG_FIFO_DATA_OUT_TAG));
+
+	struct rtio_sqe *recovery = start_stream();
+	uint32_t buf_len;
+
+	prepare_attempt();
+	pulse_interrupt();
+	uint8_t *buf = expect_success(&buf_len);
+	zassert_equal(1, lsm6dsv16x_emul_read_count(REG_FIFO_STATUS1));
+	zassert_equal(1, lsm6dsv16x_emul_read_count(REG_FIFO_DATA_OUT_TAG));
+	rtio_release_buffer(&stream_ctx, buf, buf_len);
+	stop_stream(recovery);
+}
+
+ZTEST(lsm6dsv16x_stream, test_fifo_payload_read_failure_recovers)
+{
+	start_stream();
+	prepare_attempt();
+	lsm6dsv16x_emul_fail_next_read(REG_FIFO_DATA_OUT_TAG, -EIO, 0xa5);
+	pulse_interrupt();
+	expect_error(-EIO);
+	zassert_equal(1, lsm6dsv16x_emul_read_count(REG_FIFO_STATUS1));
+	zassert_equal(1, lsm6dsv16x_emul_read_count(REG_FIFO_DATA_OUT_TAG));
+
+	struct rtio_sqe *recovery = start_stream();
+	uint32_t buf_len;
+
+	prepare_attempt();
+	pulse_interrupt();
+	uint8_t *buf = expect_success(&buf_len);
+	zassert_equal(1, lsm6dsv16x_emul_read_count(REG_FIFO_STATUS1));
+	zassert_equal(1, lsm6dsv16x_emul_read_count(REG_FIFO_DATA_OUT_TAG));
+	rtio_release_buffer(&stream_ctx, buf, buf_len);
+	stop_stream(recovery);
+}
+
+ZTEST(lsm6dsv16x_stream, test_receive_pool_exhaustion_recovers)
+{
+	struct rtio_sqe *first = start_stream();
+	uint32_t held_len;
+
+	prepare_attempt();
+	pulse_interrupt();
+	uint8_t *held = expect_success(&held_len);
+
+	/* The multishot request is live again, but its only receive block is held. */
+	lsm6dsv16x_emul_clear_read_counts();
+	lsm6dsv16x_emul_set_fifo(fifo_payload);
+	pulse_interrupt();
+	expect_error(-ENOMEM);
+	zassert_equal(1, lsm6dsv16x_emul_read_count(REG_FIFO_STATUS1));
+	zassert_equal(0, lsm6dsv16x_emul_read_count(REG_FIFO_DATA_OUT_TAG));
+	ARG_UNUSED(first);
+
+	rtio_release_buffer(&stream_ctx, held, held_len);
+
+	struct rtio_sqe *recovery = start_stream();
+	uint32_t buf_len;
+
+	prepare_attempt();
+	pulse_interrupt();
+	uint8_t *buf = expect_success(&buf_len);
+	zassert_equal(1, lsm6dsv16x_emul_read_count(REG_FIFO_STATUS1));
+	zassert_equal(1, lsm6dsv16x_emul_read_count(REG_FIFO_DATA_OUT_TAG));
+	rtio_release_buffer(&stream_ctx, buf, buf_len);
+	stop_stream(recovery);
+}
+
+ZTEST(lsm6dsv16x_stream, test_mixed_fifo_and_drdy_is_rejected_without_leaking_state)
+{
+	lsm6dsv16x_emul_clear_read_counts();
+	start_stream_iodev(&mixed_stream_iodev);
+	expect_error(-ENOTSUP);
+	zassert_equal(0, lsm6dsv16x_emul_read_count(REG_FIFO_STATUS1));
+	zassert_equal(0, lsm6dsv16x_emul_read_count(REG_FIFO_DATA_OUT_TAG));
+
+	struct rtio_sqe *recovery = start_stream();
+	uint32_t buf_len;
+
+	prepare_attempt();
+	pulse_interrupt();
+	uint8_t *buf = expect_success(&buf_len);
+	rtio_release_buffer(&stream_ctx, buf, buf_len);
+	stop_stream(recovery);
+}
+
+static void *lsm6dsv16x_stream_setup(void)
+{
+	zassert_true(device_is_ready(sensor), "sensor failed to initialize");
+	zassert_true(gpio_is_ready_dt(&interrupt));
+	zassert_ok(gpio_emul_input_set_dt(&interrupt, 0));
+	return NULL;
+}
+
+ZTEST_SUITE(lsm6dsv16x_stream, NULL, lsm6dsv16x_stream_setup, NULL, NULL, NULL);
diff --git a/tests/drivers/sensor/lsm6dsv16x_stream/testcase.yaml b/tests/drivers/sensor/lsm6dsv16x_stream/testcase.yaml
new file mode 100644
index 00000000000..afea862891c
--- /dev/null
+++ b/tests/drivers/sensor/lsm6dsv16x_stream/testcase.yaml
@@ -0,0 +1,8 @@
+tests:
+  drivers.sensor.lsm6dsv16x.stream_faults:
+    platform_allow:
+      - native_sim
+    tags:
+      - drivers
+      - sensor
+      - rtio
