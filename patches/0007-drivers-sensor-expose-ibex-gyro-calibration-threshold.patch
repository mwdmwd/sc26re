+	uint8_t page_values[UINT8_MAX + 1];
 	uint32_t read_count[UINT8_MAX + 1];
 	uint32_t write_count[UINT8_MAX + 1];
 	uint8_t func_cfg_access;
 	uint8_t address;
+	uint8_t page_address;
