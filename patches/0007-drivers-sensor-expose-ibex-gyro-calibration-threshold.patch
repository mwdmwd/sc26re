+
+void lsm6dsv16x_emul_pause_next_transfer(uint8_t reg, bool read)
+{
+	k_sem_reset(&transfer_paused);
+	k_sem_reset(&transfer_resume);
+	emul_data.pause_reg = reg;
+	emul_data.pause_read = read;
+	emul_data.pause_armed = true;
+}
+
+int lsm6dsv16x_emul_wait_paused(k_timeout_t timeout)
+{
+	return k_sem_take(&transfer_paused, timeout);
