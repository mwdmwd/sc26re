 	uint8_t fail_reg;
 	uint8_t fail_fill;
 	int fail_error;
 	bool fail_armed;
+	uint8_t pause_reg;
+	bool pause_read;
+	bool pause_armed;
 };
 
 static struct lsm6dsv16x_emul_data emul_data;
+K_SEM_DEFINE(transfer_paused, 0, 1);
+K_SEM_DEFINE(transfer_resume, 0, 1);
 
 static uint8_t emul_read_byte(struct lsm6dsv16x_emul_data *data, uint8_t reg)
 {
@@ -80,6 +91,15 @@ static void emul_write_byte(struct lsm6dsv16x_emul_data *data, uint8_t reg, uint
 		}
 		return;
 	}
+	if (data->bank == BANK_EMBEDDED) {
+		if (reg == REG_PAGE_RW) {
