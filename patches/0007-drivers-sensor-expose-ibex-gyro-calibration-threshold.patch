+K_THREAD_STACK_DEFINE(threshold_stack, 2048);
+static struct k_thread threshold_thread;
+static int threshold_result;
+K_SEM_DEFINE(threshold_started, 0, 1);
+K_SEM_DEFINE(threshold_done, 0, 1);
+
+static void set_threshold(void *arg1, void *arg2, void *arg3)
+{
+	struct sensor_value threshold = { .val1 = 50 };
+
+	ARG_UNUSED(arg1);
+	ARG_UNUSED(arg2);
+	ARG_UNUSED(arg3);
+	k_sem_give(&threshold_started);
+	threshold_result = sensor_attr_set(sensor, SENSOR_CHAN_GYRO_XYZ,
+					  SENSOR_ATTR_LSM6DSV16X_GYRO_CALIBRATION_THRESHOLD,
+					  &threshold);
+	k_sem_give(&threshold_done);
+}
+
+static void start_threshold_update(void)
+{
+	k_sem_reset(&threshold_started);
+	k_sem_reset(&threshold_done);
+	k_thread_create(&threshold_thread, threshold_stack, K_THREAD_STACK_SIZEOF(threshold_stack),
+			set_threshold, NULL, NULL, NULL, K_PRIO_PREEMPT(8), 0, K_NO_WAIT);
+	zassert_ok(k_sem_take(&threshold_started, K_SECONDS(1)));
+}
+
+static void finish_threshold_update(void)
+{
+	zassert_ok(k_thread_join(&threshold_thread, K_SECONDS(2)));
+	zassert_ok(threshold_result);
+	zassert_equal(0x40, lsm6dsv16x_emul_page_get(0x98));
+	zassert_equal(0x15, lsm6dsv16x_emul_page_get(0x99));
+}
