+/* Convert the positive threshold used by the embedded calibration engine to binary16. */
+static uint16_t lsm6dsv16x_positive_float_to_half(float value)
+{
+	uint32_t bits;
+	uint32_t significand;
+	uint32_t rounded;
+	uint32_t remainder;
+	uint32_t halfway;
+	int32_t exponent;
+	int32_t shift;
+
+	memcpy(&bits, &value, sizeof(bits));
+	if (value == 0.0f) {
+		return 0;
+	}
+	exponent = (int32_t)((bits >> 23) & 0xffU) - 127;
+	significand = (bits & 0x7fffffU) | 0x800000U;
+	shift = exponent < -14 ? -exponent - 1 : 13;
+	rounded = significand >> shift;
+	remainder = significand & ((1U << shift) - 1U);
+	halfway = 1U << (shift - 1);
+	if (remainder > halfway || (remainder == halfway && (rounded & 1U) != 0U)) {
+		++rounded;
+	}
+	if (exponent < -14) {
+		return (uint16_t)rounded;
+	}
+	return (uint16_t)(((exponent + 15) << 10) + rounded - 0x400U);
+}
+
+static int lsm6dsv16x_gyro_calibration_threshold_set(const struct device *dev, uint8_t percent)
+{
+	/* Ibex 6A628345 pauses SFLP, then writes a binary16 value to embedded page 0,
+	 * address 0x98. That address is absent from ST's public register names.
+	 */
+	const struct lsm6dsv16x_config *cfg = dev->config;
+	stmdev_ctx_t *ctx = (stmdev_ctx_t *)&cfg->ctx;
+	float threshold = (float)percent * 0.0025641f / 100.0f;
+	uint16_t half = lsm6dsv16x_positive_float_to_half(threshold);
+	uint8_t saved_enable;
+	uint8_t value;
+	bool saved_valid = false;
+	bool page_write_enabled = false;
+	int ret;
+
+#ifdef CONFIG_LSM6DSV16X_STREAM
+	struct lsm6dsv16x_data *data = dev->data;
+
+	/* Wait for the entire asynchronous FIFO read, not just one bus transaction. */
+	k_sem_take(&data->stream_io, K_FOREVER);
+#endif
+	ret = lsm6dsv16x_mem_bank_set(ctx, LSM6DSV16X_EMBED_FUNC_MEM_BANK);
+	if (ret != 0) {
+		ret = -EIO;
+		goto unlock;
+	}
+	ret = lsm6dsv16x_read_reg(ctx, LSM6DSV16X_EMB_FUNC_EN_A, &saved_enable, 1);
+	if (ret != 0) {
+		goto restore;
+	}
+	saved_valid = true;
+	value = 3;
+	ret = lsm6dsv16x_write_reg(ctx, LSM6DSV16X_PAGE_SEL, &value, 1);
+	if (ret != 0) {
+		goto restore;
+	}
+	value = 0;
+	ret = lsm6dsv16x_write_reg(ctx, LSM6DSV16X_EMB_FUNC_EN_A, &value, 1);
+	if (ret != 0) {
+		goto restore;
+	}
+	ret = lsm6dsv16x_write_reg(ctx, LSM6DSV16X_EMB_FUNC_INIT_A, &value, 1);
+	if (ret != 0) {
+		goto restore;
+	}
+	value = 1;
+	ret = lsm6dsv16x_write_reg(ctx, LSM6DSV16X_PAGE_SEL, &value, 1);
+	if (ret != 0) {
+		goto restore;
+	}
+	for (unsigned int attempt = 0; attempt < 1000U; ++attempt) {
+		ret = lsm6dsv16x_read_reg(ctx, LSM6DSV16X_EMB_FUNC_EXEC_STATUS, &value, 1);
+		if (ret != 0 || (value & 1U) != 0U) {
+			break;
+		}
+	}
+	if (ret != 0) {
+		goto restore;
+	}
+	if ((value & 1U) == 0U) {
+		ret = -ETIMEDOUT;
+		goto restore;
+	}
+	value = 0x40;
+	ret = lsm6dsv16x_write_reg(ctx, LSM6DSV16X_PAGE_RW, &value, 1);
+	if (ret != 0) {
+		goto restore;
+	}
+	page_write_enabled = true;
+	value = 0x98;
+	ret = lsm6dsv16x_write_reg(ctx, LSM6DSV16X_PAGE_ADDRESS, &value, 1);
+	if (ret != 0) {
+		goto restore;
+	}
+	value = (uint8_t)half;
+	ret = lsm6dsv16x_write_reg(ctx, LSM6DSV16X_PAGE_VALUE, &value, 1);
+	if (ret != 0) {
+		goto restore;
+	}
+	value = (uint8_t)(half >> 8);
+	ret = lsm6dsv16x_write_reg(ctx, LSM6DSV16X_PAGE_VALUE, &value, 1);
+
+restore:
+	value = 0;
+	if (page_write_enabled && lsm6dsv16x_write_reg(ctx, LSM6DSV16X_PAGE_RW,
+	                                                &value, 1) != 0 && ret == 0) {
+		ret = -EIO;
+	}
+	if (saved_valid && lsm6dsv16x_write_reg(ctx, LSM6DSV16X_EMB_FUNC_EN_A,
+	                                      &saved_enable, 1) != 0 && ret == 0) {
+		ret = -EIO;
+	}
+	if (lsm6dsv16x_mem_bank_set(ctx, LSM6DSV16X_MAIN_MEM_BANK) != 0 && ret == 0) {
+		ret = -EIO;
+	}
+unlock:
+#ifdef CONFIG_LSM6DSV16X_STREAM
+	k_sem_give(&data->stream_io);
+#endif
+	return ret < 0 ? ret : 0;
+}
+
 static int lsm6dsv16x_gyro_config(const struct device *dev,
 			       enum sensor_channel chan,
 			       enum sensor_attribute attr,
@@ -612,6 +745,11 @@ static int lsm6dsv16x_gyro_config(const struct device *dev,
 	lsm6dsv16x_gy_mode_t mode;
 
