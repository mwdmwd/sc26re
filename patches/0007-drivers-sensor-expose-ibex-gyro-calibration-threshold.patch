 }
@@ -88,6 +108,7 @@ static int lsm6dsv16x_emul_transfer(const struct emul *target, struct i2c_msg *m
 				    int addr)
 {
 	struct lsm6dsv16x_emul_data *data = target->data;
+	bool pause = false;
 
