@@ -13,6 +13,9 @@
 
 #define REG_FUNC_CFG_ACCESS      0x01
 #define REG_EMB_FUNC_EXEC_STATUS 0x07
+#define REG_PAGE_ADDRESS         0x08
+#define REG_PAGE_VALUE           0x09
+#define REG_PAGE_RW              0x17
 #define REG_WHO_AM_I             0x0f
 #define REG_FIFO_STATUS1         0x1b
 #define REG_STATUS               0x1e
@@ -32,18 +35,26 @@ enum register_bank {
 
