 }
 
 static int lsm6dsv16x_read_reg_async(const struct device *dev, uint8_t reg_addr, uint8_t *buf,
@@ -440,9 +444,6 @@ static void lsm6dsv16x_read_fifo_cb(struct rtio *r, const struct rtio_sqe *sqe,
 			return;
 		}
 
-		/* complete request with ok */
-		lsm6dsv16x_complete_streaming_sqe(lsm6dsv16x, 0);
-
 		if (data_opt == SENSOR_STREAM_DATA_DROP) {
 
 			/*
@@ -452,18 +453,29 @@ static void lsm6dsv16x_read_fifo_cb(struct rtio *r, const struct rtio_sqe *sqe,
 			 *
 			 *   lsm6dsv16x_fifo_mode_set(ctx, LSM6DSV16X_BYPASS_MODE);
 			 */
-			struct rtio_sqe *write_fifo_mode = rtio_sqe_acquire(rtio);
+			struct rtio_sqe *sqes[2];
 			uint8_t lsm6dsv16x_fifo_mode_set[] = {
 				LSM6DSV16X_FIFO_CTRL4,
 				LSM6DSV16X_BYPASS_MODE,
 			};
 
-			write_fifo_mode->flags |= RTIO_SQE_NO_RESPONSE;
-			rtio_sqe_prep_tiny_write(write_fifo_mode, iodev,
+			result = rtio_sqe_acquire_array(rtio, ARRAY_SIZE(sqes), sqes);
+			if (result != 0) {
+				lsm6dsv16x_complete_streaming_sqe(lsm6dsv16x, result);
+				return;
+			}
+			rtio_sqe_prep_tiny_write(sqes[0], iodev,
 						 RTIO_PRIO_NORM, lsm6dsv16x_fifo_mode_set,
 						 ARRAY_SIZE(lsm6dsv16x_fifo_mode_set), NULL);
-
-			rtio_submit(rtio, 0);
+			sqes[0]->flags = RTIO_SQE_CHAINED;
+			rtio_sqe_prep_callback_no_cqe(sqes[1], lsm6dsv16x_complete_op_cb,
+						      (void *)dev, lsm6dsv16x->streaming_sqe);
+			result = rtio_submit(rtio, 0);
+			if (result != 0) {
+				lsm6dsv16x_complete_streaming_sqe(lsm6dsv16x, result);
+			}
+		} else {
+			lsm6dsv16x_complete_streaming_sqe(lsm6dsv16x, 0);
 		}
 
 		return;
@@ -641,6 +653,8 @@ static void lsm6dsv16x_read_status_cb(struct rtio *r, const struct rtio_sqe *sqe
 		if (result != 0) {
 			lsm6dsv16x_complete_streaming_sqe(lsm6dsv16x, result);
 		}
+	} else {
+		lsm6dsv16x_complete_streaming_sqe(lsm6dsv16x, -ENODATA);
 	}
 }
 
@@ -651,7 +665,7 @@ static void lsm6dsv16x_read_status_cb(struct rtio *r, const struct rtio_sqe *sqe
  *     - int_fifo_full (SENSOR_TRIG_FIFO_FULL)
  *     - int_drdy (SENSOR_TRIG_DATA_READY)
  */
-void lsm6dsv16x_stream_irq_handler(const struct device *dev)
+static void lsm6dsv16x_stream_read(const struct device *dev)
 {
 	struct lsm6dsv16x_data *lsm6dsv16x = dev->data;
 #if LSM6DSVXXX_ANY_INST_ON_BUS_STATUS_OKAY(i3c)
@@ -662,6 +676,7 @@ void lsm6dsv16x_stream_irq_handler(const struct device *dev)
 	int rc;
 
 	if (lsm6dsv16x->streaming_sqe == NULL) {
+		k_sem_give(&lsm6dsv16x->stream_io);
 		return;
 	}
 
@@ -725,6 +740,7 @@ void lsm6dsv16x_stream_irq_handler(const struct device *dev)
 #if LSM6DSVXXX_ANY_INST_ON_BUS_STATUS_OKAY(i3c)
 		}
 #endif
+		return;
 	}
 
 	/* handle drdy trigger */
@@ -749,5 +765,36 @@ void lsm6dsv16x_stream_irq_handler(const struct device *dev)
 		if (rc != 0) {
 			lsm6dsv16x_complete_streaming_sqe(lsm6dsv16x, rc);
 		}
+		return;
 	}
+	k_sem_give(&lsm6dsv16x->stream_io);
+}
+
+static void lsm6dsv16x_stream_irq_work(struct k_work *work)
+{
+	struct lsm6dsv16x_data *data = CONTAINER_OF(work, struct lsm6dsv16x_data,
+						stream_irq_work);
+
+	k_sem_take(&data->stream_io, K_FOREVER);
+	lsm6dsv16x_stream_read(data->dev);
+}
+
+void lsm6dsv16x_stream_init(const struct device *dev)
+{
+	struct lsm6dsv16x_data *data = dev->data;
+
+	k_sem_init(&data->stream_io, 1, 1);
+	k_work_init(&data->stream_irq_work, lsm6dsv16x_stream_irq_work);
+}
+
+void lsm6dsv16x_stream_irq_handler(const struct device *dev)
+{
+	struct lsm6dsv16x_data *data = dev->data;
+
+	if (k_sem_take(&data->stream_io, K_NO_WAIT) != 0) {
+		/* GPIO is already masked. Keep the request and service it after the bank change. */
+		k_work_submit(&data->stream_irq_work);
+		return;
+	}
+	lsm6dsv16x_stream_read(dev);
 }
