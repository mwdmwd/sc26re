+		if (val->val1 < 0 || val->val1 > UINT8_MAX || val->val2 != 0) {
+			return -EINVAL;
+		}
+		return lsm6dsv16x_gyro_calibration_threshold_set(dev, (uint8_t)val->val1);
 	case SENSOR_ATTR_FULL_SCALE:
 		return lsm6dsv16x_gyro_range_set(dev, sensor_rad_to_degrees(val));
 	case SENSOR_ATTR_SAMPLING_FREQUENCY:
@@ -1450,6 +1588,9 @@ static int lsm6dsv16x_init(const struct device *dev)
 	LOG_INF("Initialize device %s", dev->name);
 	data->dev = dev;
 
+#ifdef CONFIG_LSM6DSV16X_STREAM
+	lsm6dsv16x_stream_init(dev);
+#endif
 	if (lsm6dsv16x_init_chip(dev) < 0) {
 		LOG_DBG("failed to initialize chip");
 		return -EIO;
